{
  "name": "taxi-and-fly-maps",
  "version": "0.1.0",
  "private": true,
  "description": "Custom Taxi and Fly map engine for Attica. Own renderer, database, search and editor. Cartography from OpenStreetMap (ODbL), not Google.",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "import:seed": "node src/import-osm.js --mode seed",
    "import:attica": "node src/import-osm.js --mode attica",
    "import:bbox": "node src/import-osm.js --mode bbox",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "sharp": "^0.34.2"
  }
}
